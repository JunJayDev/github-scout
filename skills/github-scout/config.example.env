# Copy to ${XDG_CONFIG_HOME:-~/.config}/github-scout/config.env (or set GITHUB_SCOUT_CONFIG).
# Parsed as KEY=value, never executed. Environment variables of the same name win.

# Registry directory. Without it, the first `github-scout ask` creates ~/.github-scout.
GITHUB_SCOUT_STORE=
# Project used when a question is written without "<project>/" (otherwise: the git repo's name, or scratch).
GITHUB_SCOUT_PROJECT=
