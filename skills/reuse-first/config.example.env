# Copy to ${XDG_CONFIG_HOME:-~/.config}/reuse-first/config.env (or set REUSE_FIRST_CONFIG).
# Parsed as KEY=value, never executed. Environment variables of the same name win.

# Registry directory (created with `reuse-first init <dir>`).
REUSE_FIRST_STORE=
# Project used when a need is written without "<project>/".
REUSE_FIRST_PROJECT=
